# nowCRM environment template.
# Copy to .env and fill in — `make init-env` does this and generates every secret.
# Values are shared by all services.
# per-service .env files exist only for running a single app outside Docker.


# =============================================================================
# Stack
# =============================================================================
NODE_ENV="development"
NT_STACK_VERSION="0.0.130"
VERSION="latest"                 # image tag pulled by docker-compose.prod.yaml
TEST_RUN=false                   # true seeds test fixtures on Strapi boot
TEST_CRM_PORT="3100"             # host port of the CRM in docker-compose.test.yaml

CUSTOMER_DOMAIN=                 # public domain; also expands into the e-mail defaults below
SSL_EMAIL=                       # ACME contact address, required by caddy/Caddyfile in production


# =============================================================================
# Internal endpoints (container-to-container)
# =============================================================================
# Running services on the host instead? Swap the service names for localhost.
API_GATEWAY="http://krakend:8080/"
STRAPI_URL="http://strapi:1337/api/"

KRAKEND_COMPOSER_URL="http://composer:3020"
KRAKEND_JOURNEYS_URL="http://journeys:3010"
KRAKEND_DAL_URL="http://dal:6001"
KRAKEND_STRAPI_URL="http://strapi:1337"


# =============================================================================
# RabbitMQ
# =============================================================================
RABBITMQ_USER="guest"
RABBITMQ_PASS="guest"
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672"   # credentials must match the two above

RABBITMQ_PREFETCH_COUNT="10"
RABBITMQ_CONSUMER_CONCURRENCY="1"
RABBITMQ_RECONNECT_DELAY_MS="5000"
RABBITMQ_MAX_RECONNECT_ATTEMPTS="10"
RABBITMQ_MAX_RETRIES="3"
RABBITMQ_RETRY_INITIAL_DELAY_MS="1000"
RABBITMQ_RETRY_MAX_DELAY_MS="30000"


# =============================================================================
# Strapi — database
# =============================================================================
STRAPI_DATABASE_CLIENT=postgres
STRAPI_DATABASE_HOST=dbdt
STRAPI_DATABASE_PORT=5432
STRAPI_DATABASE_NAME=""
STRAPI_DATABASE_USERNAME=""
STRAPI_DATABASE_PASSWORD=""
STRAPI_DATABASE_SCHEMA="public"
STRAPI_DATABASE_RDS="false"
STRAPI_DATABASE_POOL_MIN=10
STRAPI_DATABASE_POOL_MAX=500

STRAPI_DATABASE_SSL=false
STRAPI_DATABASE_SSL_REJECT_UNAUTHORIZED=true
STRAPI_DATABASE_SSL_CA=""
STRAPI_DATABASE_SSL_CAPATH=""
STRAPI_DATABASE_SSL_CERT=""
STRAPI_DATABASE_SSL_KEY=""
STRAPI_DATABASE_SSL_CIPHER=""


# =============================================================================
# Strapi — secrets and admin access
# =============================================================================
STRAPI_APP_KEYS=""
STRAPI_ADMIN_JWT_SECRET=""
STRAPI_API_TOKEN_SALT=""
STRAPI_TRANSFER_TOKEN_SALT=""
STRAPI_ENCRYPTION_KEY=""         # encrypts stored provider credentials; rotating it invalidates them
# Signs end-user JWTs. Leave it unset and Strapi generates one into the container
# filesystem, so every container recreate silently signs everyone out.
STRAPI_JWT_SECRET=""

STRAPI_STANDART_EMAIL="techadmin@CUSTOMER_DOMAIN"    # super admin created on first boot
STRAPI_TEST_ADMIN_EMAIL="techadmin@CUSTOMER_DOMAIN"
STRAPI_TEST_ADMIN_PASSWORD=""
STRAPI_BACKEND_ORIGIN="http://localhost:1337"        # base URL Strapi registers its webhooks with

STRAPI_PAGINATION_MAX_PAGES="100"
STRAPI_PAGINATION_MAX_RECORDS="10000"


# =============================================================================
# Strapi — S3 media storage
# =============================================================================
STRAPI_AWS_REGION=""
STRAPI_AWS_ACCESS_KEY_ID=""
STRAPI_AWS_ACCESS_SECRET=""
STRAPI_AWS_BUCKET=""
STRAPI_AWS_ACL=""
STRAPI_AWS_SIGNED_URL_EXPIRES=""


# =============================================================================
# CRM (Next.js front end)
# =============================================================================
CRM_BASE_URL="http://localhost:3000"
CRM_STRAPI_API_TOKEN=""          # written by scripts/inject-strapi-token.sh

CRM_AUTH_SECRET=""
CRM_AUTH_URL="http://localhost:3000/api/auth"
CRM_AUTH_TRUST_HOST=false        # true only when running behind a TLS proxy

CRM_TOTP_ENCRYPTION_KEY=""
twoFA_ENABLED=false

# S3 bucket backing the rich-text editor uploads
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_PUBLIC_URL_BASE=""

# Playwright sign-in fixture; see apps/nowcrm/tests
TEST_USER_USERNAME=""
TEST_USER_PASSWORD=""


# =============================================================================
# Composer
# =============================================================================
COMPOSER_PORT="3020"
COMPOSER_HOST="composer"
COMPOSER_CORS_ORIGIN="http://composer:*"
COMPOSER_COMMON_RATE_LIMIT_MAX_REQUESTS="300"    # per window, per authenticated caller
COMPOSER_COMMON_RATE_LIMIT_WINDOW_MS="60000"     # rate limit window length
COMPOSER_STRAPI_API_TOKEN=""                     # written by scripts/inject-strapi-token.sh
COMPOSER_CRM_REDIRECT_HEALTH_CHECK="http://localhost:3000/crm/admin-panel/channels"

COMPOSER_REDIS_HOST="redis"
COMPOSER_REDIS_PORT="6379"

COMPOSER_OPENAI_API_KEY=""
COMPOSER_ANTHROPIC_KEY=""

COMPOSER_SMTP_HOST=""
COMPOSER_SMTP_PORT="18000"
COMPOSER_SMTP_USER=""
COMPOSER_SMTP_PASS=""
COMPOSER_CUSTOMER_IDENTITY=""                    # verified sender identity checked on send


# =============================================================================
# Journeys
# =============================================================================
JOURNEYS_PORT="3010"
JOURNEYS_HOST="journeys"
JOURNEYS_CORS_ORIGIN="http://journeys:*"
JOURNEYS_COMMON_RATE_LIMIT_MAX_REQUESTS="300"    # per window, per authenticated caller
JOURNEYS_COMMON_RATE_LIMIT_WINDOW_MS="60000"     # rate limit window length
JOURNEYS_STRAPI_API_TOKEN=""                     # written by scripts/inject-strapi-token.sh
JOURNEYS_MINUTE_TO_LAUNCH="1"

JOURNEYS_REDIS_HOST="redis"
JOURNEYS_REDIS_PORT="6379"
JOURNEYS_REDIS_MAX_RETRIES="3"
JOURNEYS_REDIS_RETRY_DELAY_MS="1000"
JOURNEYS_REDIS_CONNECT_TIMEOUT="10000"
JOURNEYS_REDIS_COMMAND_TIMEOUT="5000"
JOURNEYS_REDIS_LAZY_CONNECT="0"                  # 0 or 1
REDIS_CLEANUP_CRON="0 2 * * *"

# Job lifecycle
JOURNEYS_CHECK_TIME="1440"                       # minutes before a processed job is rolled over
JOURNEYS_JOB_FAIL_LIFE_TIME_DAYS="1"
JOURNEYS_JOB_COMPLETED_LIFE_TIME_DAYS="1"
JOURNEYS_JOB_KEY_BASE_TTL_SECONDS="3600"         # dedupe key lifetime for immediate jobs
JOURNEYS_JOB_KEY_MAX_TTL_SECONDS="2592000"
JOURNEYS_JOB_KEY_PROCESSING_BUFFER_SECONDS="300" # safety margin added to every dedupe key TTL

# Timeouts and retries
JOURNEYS_STRAPI_REQUEST_TIMEOUT_MS="120000"      # covers rate-limiter queueing, not just one call
JOURNEYS_SUBSCRIPTION_ERROR_RETRY_DELAY_MS="3600000"
JOURNEYS_PAUSED_JOURNEY_RETRY_DELAY_MS="3600000"

CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
CIRCUIT_BREAKER_RESET_TIMEOUT_MS="60000"
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS="3"


# =============================================================================
# DAL
# =============================================================================
DAL_PORT="6001"
DAL_HOST="dal"
DAL_CORS_ORIGIN="http://dal:*"
DAL_COMMON_RATE_LIMIT_MAX_REQUESTS="300"         # per window, per authenticated caller
DAL_COMMON_RATE_LIMIT_WINDOW_MS="60000"          # rate limit window length
DAL_STRAPI_API_URL="http://strapi:1337/api/"
DAL_STRAPI_API_TOKEN=""                          # written by scripts/inject-strapi-token.sh
DAL_MINUTE_TO_LAUNCH="1"

DAL_BASIC_AUTH_USERNAME=""
DAL_BASIC_AUTH_PASSWORD=""

DAL_REDIS_HOST="redis"
DAL_REDIS_PORT="6379"
DAL_WORKER_COUNT="4"
DAL_JOB_CONCURRENCY="1"
DAL_CHECK_TIME="1440"                            # minutes before a processed job is rolled over
DAL_JOB_FAIL_LIFE_TIME_DAYS="1"
DAL_JOB_COMPLETED_LIFE_TIME_DAYS="1"

DAL_DATABASE_CLIENT="postgresql"
# Leave the host empty to use each stack's own database service (dev: dbdt, prod: postgres).
# Set it only to point DAL at an external/managed database.
DAL_DATABASE_HOST=
DAL_DATABASE_PORT=5432
DAL_DATABASE_NAME=""
DAL_DATABASE_USERNAME=""
DAL_DATABASE_PASSWORD=""
DAL_DATABASE_RDS=false
DAL_DATABASE_SSL_SELF=false

DAL_SMTP_HOST="smtp"
DAL_SMTP_PORT="18000"
DAL_SMTP_USER=""
DAL_SMTP_PASS=""
DAL_SMTP_FROM="administrator@CUSTOMER_DOMAIN"


# =============================================================================
# Plugins
# =============================================================================
PLUGINS_PORT="3030"
PLUGINS_HOST="plugins"
PLUGINS_CORS_ORIGIN="http://plugins:*"
PLUGINS_COMMON_RATE_LIMIT_MAX_REQUESTS="300"     # per window, per authenticated caller
PLUGINS_COMMON_RATE_LIMIT_WINDOW_MS="60000"      # rate limit window length
PLUGINS_STRAPI_API_TOKEN=""                      # written by scripts/inject-strapi-token.sh

PLUGINS_NPMRC_TOKEN=""                           # GitHub token for private npm packages
PLUGINS_GIT_TOKEN=""                             # GitHub token for git+https:// installs

# Comma-separated packages to install. Format: "<type>:<package>[@version]",
# where type is node (default) or python.
# e.g. "@nowcrm/plugin-one,node:@nowcrm/plugin-two@1.0.0,python:pkg-name@1.2.3"
PLUGINS_PACKAGE_NAMES=""
PLUGINS_INSTALL_DIR="./plugins-internal"

PLUGINS_PYTHON_PATH="python3"
PLUGINS_PYTHON_VENV_DIR="./plugins-internal/python-venv"

# Cron per plugin, e.g. {"bexio-sync-plugin": "0 2 * * *"}
PLUGINS_SCHEDULES="{}"
