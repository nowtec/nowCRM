          "{{ env "KRAKEND_STRAPI_URL" }}"
        ],
        "encoding": "json",
        "extra_config": {
          "backend/http": {
            "headers_to_pass": [
              "Authorization"
            ], 
            "return_error_details": "backend_status"
          }
        }
      }
    ]
  }
]