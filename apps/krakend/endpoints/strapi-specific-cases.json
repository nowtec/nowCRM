[
    {
    "endpoint": "/strapi/api/lists/{id}/active-contacts-count",
    "method": "GET",
    "output_encoding": "json",
    "input_headers": [
      "Authorization",
      "Content-Type",
      "Content-Lenght"
    ],
    "input_query_strings": [
      "*"
    ],
    "backend": [
      {
        "url_pattern": "/api/lists/{id}/active-contacts-count",
