      "name": [
        "auth-plugin"
      ],
      "auth-plugin": {
        "auth_url": "{{ env "KRAKEND_STRAPI_URL" }}/api/token-verify",
        "auth_header_name": "Authorization",
        "timeout": "5s",
        "cache_ttl": "600s",
        "excluded_paths": [
          "/health-check/composer",
          "/health-check/journeys",
          "/health-check/dal"
        ]
      }
    },
    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Content-Type",
        "Authorization"
      ],
      "expose_headers": [
        "Content-Length"
      ],
      "max_age": "12h",
      "allow_credentials": false
    },
    "security/http": {
      "allowed_hosts": [],
      "ssl_redirect": false,
      "frame_deny": true,
      "content_type_nosniff": true,
      "browser_xss_filter": true,
      "referrer_policy": "same-origin"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  }
}
