# Environment Configuration
NODE_ENV="development"
PLUGINS_PORT="3030"
PLUGINS_HOST="localhost"

PLUGINS_CORS_ORIGIN="http://localhost:3000"
PLUGINS_COMMON_RATE_LIMIT_MAX_REQUESTS="100"

# Plugin Configuration
# GitHub npm token for accessing private packages
PLUGINS_NPMRC_TOKEN=""

# Comma-separated list of plugin packages to install
# Format: "node:@org/plugin1,node:@org/plugin2@1.0.0,python:package-name,python:another-package@1.2.3"
# Type prefix (node: or python:) is optional - defaults to "node" if not specified
# Examples:
#   - "node:@nowcrm/plugin-one" - Node.js plugin
#   - "@nowcrm/plugin-two" - Node.js plugin (default type)
#   - "python:git+https://github.com/nowtec/nowCRM-plugins@main#subdirectory=packages/pkg_a" - Python plugin from Git
PLUGINS_PACKAGE_NAMES=""

# Directory where Node.js plugins will be installed
PLUGINS_INSTALL_DIR="./plugins-internal"

# Python Configuration
# Python executable path (python3, python, or full path)
PLUGINS_PYTHON_PATH="python3"

# Python virtual environment directory
PLUGINS_PYTHON_VENV_DIR="./plugins-internal/python-venv"

# API Configuration
API_GATEWAY="http://localhost:8080"
PLUGINS_STRAPI_API_TOKEN=""
STRAPI_URL="http://localhost:1337/api"
