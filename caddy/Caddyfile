# CRM Application
crm.{$CUSTOMER_DOMAIN} {
    reverse_proxy nowcrm:3000
}

# Strapi Admin
admin.{$CUSTOMER_DOMAIN} {
    reverse_proxy strapi:1337
}

# API Gateway (KrakenD). Composer, Journeys, DAL and the Strapi API are reached
# through here at /composer/*, /journeys/*, /dal/* and /strapi/api/*.
api.{$CUSTOMER_DOMAIN} {
    reverse_proxy krakend:8080
}

# RabbitMQ Management UI
rabbitmq.{$CUSTOMER_DOMAIN} {
    reverse_proxy rabbitmq:15672
}
